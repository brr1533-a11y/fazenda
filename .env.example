# Servidor
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://SEU-SITE.onrender.com

# PostgreSQL (obrigatório em produção para dados compartilhados e persistentes)
DATABASE_URL=postgresql://usuario:senha@host/banco

# Grupo inicial (seu Grupo Fagundes Miari)
SEED_GROUP_SLUG=grupo-fagundes-miari
SEED_GROUP_CODE=1001
SEED_GROUP_NAME=Grupo Fagundes Miari
SEED_CEO_NAME=Jacques Miari
SEED_CEO_USER=jacquesmiari
SEED_CEO_PASSWORD=ALTERE_ESTA_SENHA_EM_PRODUCAO
SEED_CEO_EMAIL=seu-email@dominio.com

# Sessão
SESSION_DAYS=30

# Plano comercial
PLAN_NAME=Gestão Rural Pro
PLAN_PRICE=199.90

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN
# Opcional: se você já tiver criado um plano recorrente no Mercado Pago
MERCADOPAGO_PLAN_ID=

# Administração manual da plataforma (use uma chave longa e secreta)
PLATFORM_SETUP_KEY=troque-por-uma-chave-bem-grande-e-aleatoria

# SOMENTE PARA TESTE LOCAL. Em produção, deixe false/remova.
TEST_PURCHASE_MODE=false

# Recuperação de senha por e-mail (Resend)
# Crie uma chave no Resend e, em produção, use um remetente de domínio verificado.
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_FROM=Gestão Rural <acesso@seudominio.com>
PASSWORD_RESET_MINUTES=10
